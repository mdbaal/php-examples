{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} Helloooo{% endblock %}

{% block body %}
    <h1>
        {{ message | lower }}
    </h1>

    <h2>Repository has {{ itemCount }} items</h2>

    {% for item in items %}
        <span><a href="{{ path('app_item_show',{ name: item.name}) }}">{{ item.name }}</a></span>
        <span>{{ item.price }}</span>
        <br>
    {% endfor %}

{% endblock %}
